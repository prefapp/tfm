{
  "config": {
    "name": "release-bypass-actors",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [
      {
        "actor_type": "Team",
        "actor_slug": "platform-team",
        "bypass_mode": "always"
      },
      {
        "actor_type": "Integration",
        "actor_slug": "release-bot",
        "bypass_mode": "pull_request"
      },
      {
        "actor_type": "RepositoryRole",
        "actor_role": "admin",
        "bypass_mode": "always"
      },
      {
        "actor_type": "OrganizationAdmin",
        "bypass_mode": "pull_request"
      }
    ],
    "conditions": {
      "ref_name": {
        "include": ["~DEFAULT_BRANCH"],
        "exclude": []
      },
      "repository_name": {
        "include": ["~ALL"],
        "exclude": []
      }
    },
    "rules": [
      { "type": "deletion" },
      { "type": "non_fast_forward" }
    ]
  }
}
